rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /profile/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /contacts/{contactId} {
        // Allow visitors and attendees to exchange and submit contact details into the user's contacts vault
        allow create: if true;
        // Only the profile owner can view, update, delete or list their contacts
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /scans/{scanId} {
        // Allow visitors and attendees who scan the QR to log their scan and engagement actions
        allow create, update: if true;
        // Only the profile owner can read, list, or delete scan analytics
        allow read, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /customQRs/{qrId} {
        // Only the authenticated owner can create, read, update, or delete their custom generated QR codes
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
